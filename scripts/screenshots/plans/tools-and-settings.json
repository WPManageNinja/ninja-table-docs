  {
   "eval": "const k=document.querySelector('.nt-license__key'); if(k)k.textContent='8f60\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u20228cf2'; document.querySelectorAll('.nt-license__row').forEach(r=>{if(/Licensed to/i.test(r.textContent)){const dd=r.querySelector('dd'); if(dd)dd.innerHTML='Alex Morgan<br><small>al*****@e*****.com</small>';}});"
  },
  {
   "shot": {
    "name": "4.-License-Settings-Showing-An-Active-Ninja",
    "clip": "app",
    "crop": "auto",
    "highlights": [
     ".nt-license .nt-badge, .nt-license__head .nt-badge"
    ]
   }
  }
 ]
}