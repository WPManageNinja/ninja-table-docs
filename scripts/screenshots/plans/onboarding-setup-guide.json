{
  "doc": "docs/getting-started/onboarding-setup-guide.md",
  "outDir": "public/images/getting-started/onboarding-setup-guide",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "admin": "/create"
    },
    {
      "wait": 1500
    },
    {
      "click": {
        "text": "Default table"
      }
    },
    {
      "wait": 800
    },
    {
      "fill": {
        "selector": "#nt-new-title",
        "value": "Pricing plans"
      }
    },
    {
      "eval": "(function(){var els=[...document.querySelectorAll('.nt-drawer *')].filter(e=>/^Engine:/.test(e.textContent.trim())&&e.children.length<6);var t=els[els.length-1];t.setAttribute('data-hl','eng')})()"
    },
    {
      "shot": {
        "name": "6.-Default-Table-Panel-With-Table-Name",
        "clip": "app",
        "highlights": [
          "[data-hl=\"eng\"]"
        ]
      }
    },
    {
      "front": "{{page:Shop Price List}}/"
    },
    {
      "eval": "window.scrollTo(0,110)"
    },
    {
      "shot": {
        "name": "8.-Published-Page-Showing-A-Ninja-Tables",
        "clip": "viewport"
      }
    },
    {
      "admin": "/tables/{{Pricing Plans}}"
    },
    {
      "wait": 2500
    },
    {
      "shot": {
        "name": "6.-Table-Rows-Grid-With-Columns",
        "clip": "app",
        "highlights": [
          {
            "role": "button",
            "name": "Add data"
          }
        ],
        "crop": {
          "height": 1130
        }
      }
    }
  ]
}