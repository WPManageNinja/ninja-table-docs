{
  "doc": "docs/field-types/image-file-lightbox.md",
  "outDir": "public/images/field-types/image-file-lightbox",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "admin": "/tables/{{Product Price List}}"
    },
    {
      "wait": 2000
    },
    {
      "click": "button:has-text(\"Add column\")"
    },
    {
      "wait": 900
    },
    {
      "fill": {
        "selector": ".nt-drawer input >> nth=0",
        "value": "Product Image"
      }
    },
    {
      "click": ".nt-drawer .el-select"
    },
    {
      "click": ".el-select-dropdown__item:visible:has-text(\"Image/File/Lightbox\")"
    },
    {
      "wait": 500
    },
    {
      "eval": "document.activeElement&&document.activeElement.blur()"
    },
    {
      "shot": {
        "name": "1.-Column-Dialog-With-Type-Set",
        "clip": "viewport",
        "highlights": [
          {
            "row": "When visitors click the image",
            "part": "row"
          }
        ]
      }
    },
    {
      "click": ".nt-drawer .el-select:has-text(\"Image only\")"
    },
    {
      "wait": 600
    },
    {
      "shot": {
        "name": "2.-Click-Behavior-Options-For-An-Image",
        "clip": "viewport"
      }
    },
    {
      "admin": "/tables/{{Winter Apparel}}"
    },
    {
      "wait": 6000
    },
    {
      "click": {
        "role": "button",
        "name": "Add data"
      }
    },
    {
      "wait": 1500
    },
    {
      "click": {
        "role": "button",
        "name": "Image upload"
      }
    },
    {
      "wait": 2500
    },
    {
      "click": {
        "text": "Media Library"
      }
    },
    {
      "wait": 2500
    },
    {
      "click": ".attachments .attachment[aria-label=\"Casual Classic Hoodie\"] >> nth=0"
    },
    {
      "wait": 500
    },
    {
      "click": {
        "role": "button",
        "name": "Insert into post"
      }
    },
    {
      "wait": 2000
    },
    {
      "shot": {
        "name": "1.-Row-Drawer-With-An-Image-Uploaded",
        "clip": "app"
      }
    },
    {
      "viewport": {
        "width": 1440,
        "height": 900
      }
    },
    {
      "front": "{{page:Winter Collection}}/"
    },
    {
      "wait": 1200
    },
    {
      "eval": "window.scrollTo(0,160)"
    },
    {
      "click": ".ninja_table_wrapper img >> nth=1"
    },
    {
      "wait": 1500
    },
    {
      "shot": {
        "name": "2.-Table-With-An-Image-Column",
        "clip": "viewport"
      }
    }
  ]
}