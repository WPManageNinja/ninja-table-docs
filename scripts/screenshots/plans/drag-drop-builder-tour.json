{
  "doc": "docs/drag-drop-tables/drag-drop-builder-tour.md",
  "outDir": "public/images/drag-drop-tables/drag-drop-builder-tour",
  "viewport": { "width": 1440, "height": 900 },
  "steps": [
    { "admin": "/table_builder_edit_table/{{Website Pricing}}" },
    { "wait": 2500 },
    { "shot": { "name": "1.-Drag-Drop-Builder-With-The-Header", "clip": "app", "crop": "auto" } },
    { "click": ".ntb-canvas [aria-label=\"Mobile\"]" },
    { "wait": 1000 },
    { "shot": { "name": "2.-Canvas-Toolbar-With-The-Desktop-Tablet", "clip": "app", "crop": "auto",
        "highlights": [ ".nt-segmented[aria-label=\"Preview Width\"]" ] } },
    { "click": ".ntb-canvas [aria-label=\"Desktop\"]" },
    { "wait": 600 },
    { "shot": { "name": "3.-Elements-Tab-With-The-General", "clip": "app", "crop": "auto" } },
    { "eval": "document.querySelector('.ntb-sheet .ntb-datas-wrapper').dispatchEvent(new MouseEvent('click',{bubbles:true}))" },
    { "wait": 800 },
    { "shot": { "name": "4.-Settings-Tab-With-The-Table-Cell", "clip": "app", "crop": "auto",
        "highlights": [ ".ntb-crumbs" ] } },
    { "click": ".ntb-panel__tab:has-text(\"Responsive\")" },
    { "wait": 600 },
    { "click": ".ntb-responsive-toggle .el-switch" },
    { "wait": 800 },
    { "shot": { "name": "5.-Responsive-Tab-With-Enable-Responsive-Table", "clip": "app", "crop": "auto",
        "highlights": [ ".ntb-responsive-toggle" ] } }
  ]
}
