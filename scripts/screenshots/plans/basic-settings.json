  },
  {
   "fill": {
    "selector": ".nt-drawer input[placeholder=\"e.g. Email\"]",
    "value": "Warranty"
   }
  },
  {
   "fill": {
    "selector": ".nt-drawer input[placeholder=\"e.g. Phone\"]",
    "value": "Weight"
   }
  },
  {
   "shot": {
    "name": "3.-Add-Several-Columns-At-Once",
    "clip": "app",
