     "width": 720,
     "height": 540
    },
    "highlights": [
     {
      "selector": ".nt-col-tabs__tab",
      "hasText": "Basic"
     }
    ]
   }
  },
  {
   "click": ".nt-drawer .el-select"
  },
  {
   "wait": 600
  },
  {
   "shot": {
    "name": "2.-Type-Dropdown-With-The-Eight-Column",
    "clip": {
     "x": 720,
     "y": 32,
     "width": 720,
     "height": 610
    },
    "highlights": [
     ".nt-drawer .el-select"
    ]
   }
  },
  {
   "admin": "/"
  },
  {
   "wait": 1200
  },
  {
   "admin": "/tables/{{Product Price List}}"
  },
  {
   "wait": 1800
  },
  {
