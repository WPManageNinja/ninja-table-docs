{
  "doc": "docs/drag-drop-settings/ninja-tables-drag-and-drop-table-settings.md",
  "outDir": "public/images/drag-drop-settings/ninja-tables-drag-drop",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "viewport": {
        "width": 1440,
        "height": 1100
      }
    },
    {
      "admin": "/table_builder_edit_table/{{Website Pricing}}"
    },
    {
      "wait": 2500
    },
    {
      "click": ".ntb-panel__tab:has-text(\"Settings\")"
    },
    {
      "wait": 600
    },
    {
      "eval": "document.querySelectorAll('.el-collapse-item.is-active .el-collapse-item__header').forEach(h=>h.click())"
    },
    {
      "wait": 600
    },
    {
      "shot": {
        "name": "1.-Settings-Tab-With-The-Table-Settings",
        "clip": {
          "element": ".ntb-panel",
          "pad": 0
        },
        "crop": {
          "height": 980
        }
      }
    },
    {
      "click": {
        "selector": ".el-collapse-item__header",
        "hasText": "Layout"
      }
    },
    {
      "wait": 600
    },
    {
      "click": ".ntb-field:has-text(\"Table container max width\") .el-switch"
    },
    {
      "wait": 500
    },
    {
      "shot": {
        "name": "2.-Layout-Settings-With-The-Container-Max",
        "clip": {
          "element": ".ntb-panel",
          "pad": 0
        },
        "highlights": [
          {
            "selector": ".ntb-field",
            "hasText": "Table container max width"
          }
        ],
        "crop": {
          "height": 1900
        }
      }
    },
    {
      "click": ".ntb-field:has-text(\"Table container max width\") .el-switch"
    },
    {
      "click": {
        "selector": ".el-collapse-item__header",
        "hasText": "Layout"
      }
    },
    {
      "wait": 400
    },
    {
      "click": {
        "selector": ".el-collapse-item__header",
        "hasText": "Border"
      }
    },
    {
      "wait": 600
    },
    {
      "click": ".ntb-field:has-text(\"Apply inner border\") .el-switch"
    },
    {
      "wait": 400
    },
    {
      "shot": {
        "name": "3.-Border-Settings-With-Table-Border",
        "clip": {
          "element": ".ntb-panel",
          "pad": 0
        },
        "highlights": [
          {
            "selector": ".ntb-field",
            "hasText": "Apply inner border"
          }
        ],
        "crop": {
          "height": 1500
        }
      }
    },
    {
      "click": {
        "selector": ".el-collapse-item__header",
        "hasText": "Border"
      }
    },
    {
      "wait": 400
    },
    {
      "click": {
        "selector": ".el-collapse-item__header",
        "hasText": "Custom CSS"
      }
    },
    {
      "wait": 800
    },
    {
      "eval": "var ed=document.querySelector('.ninja_css_editor').env.editor;ed.setValue('.ntb_988 td {\\n  border-radius: 6px;\\n}\\n.ntb_988 td:hover {\\n  background: #2c2c2c;\\n}',-1)"
    },
    {
      "wait": 500
    },
    {
      "shot": {
        "name": "4.-Custom-CSS-Section-With-The-Code",
        "clip": {
          "element": ".ntb-panel",
          "pad": 0
        },
        "highlights": [
          ".ninja_css_editor"
        ],
        "crop": {
          "height": 1660
        }
      }
    }
  ]
}