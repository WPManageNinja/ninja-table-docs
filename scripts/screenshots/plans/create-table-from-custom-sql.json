{
 "doc": "docs/data-sources/create-table-from-custom-sql.md",
 "outDir": "public/images/data-sources/create-table-custom-sql",
 "viewport": {
  "width": 1440,
  "height": 900
 },
 "steps": [
  {
   "viewport": {
    "width": 1440,
    "height": 760
   }
  },
  {
   "admin": "/create"
  },
  {
   "wait": 1500
  },
  {
   "click": {
    "text": "Custom SQL Query"
   }
  },
  {
   "wait": 1500
  },
  {
   "fill": {
    "selector": "#nt-sql-title",
    "value": "Published Posts"
   }
  },
  {
   "fill": {
    "selector": ".nt-drawer.open .ace_text-input",
    "value": "SELECT post_title AS Title, post_date AS Published\nFROM {prefix}posts\nWHERE post_type = 'post'\nAND post_status = 'publish'"
   }
  },
  {
   "wait": 500
  },
  {
   "eval": "document.activeElement&&document.activeElement.blur()"
  },
  {
   "shot": {
    "name": "1.-Custom-SQL-Query-Drawer",
    "clip": {
     "element": ".nt-drawer.open",
     "pad": 0
    },
    "highlights": [
     ".nt-drawer.open .ace_editor"
    ]
   }
  },
  {
   "viewport": {
    "width": 1440,
    "height": 900
   }
  },
  {
   "admin": "/tables/1359"
  },
  {
   "wait": 4000
  },
  {
   "click": {
    "role": "button",
    "name": "Source settings"
   }
  },
  {
   "wait": 3000
  },
  {
   "eval": "(()=>{const ed=window.ace.edit(document.querySelector('.nt-drawer.open .ace_editor'));ed.setValue(\"SELECT post_title AS Title, post_date AS Published\\nFROM {prefix}posts\\nWHERE post_type = 'post'\\nAND post_status = 'publish'\\nAND post_title <> ''\\nORDER BY post_date DESC\\nLIMIT 10\", 1);})()"
  },
  {
   "wait": 500
  },
  {
   "click": {
    "role": "button",
    "name": "Save and Run"
   }
  },
  {
   "wait": 4000
  },
  {
   "click": {
    "role": "button",
    "name": "close"
   }
  },
  {
   "wait": 1500
  },
  {
   "shot": {
    "name": "2.-Table-Rows-Tab-Showing-The-Result",
    "clip": "app",
    "crop": {
     "height": 1330
    }
   }
  },
  {
   "click": {
    "role": "button",
    "name": "Source settings"
   }
  },
  {
   "wait": 3000
  },
  {
   "shot": {
    "name": "3.-Source-Settings-Drawer-Of-A-Custom",
    "clip": {
     "x": 720,
     "y": 32,
     "width": 720,
     "height": 868
    },
    "highlights": [
     {
      "role": "button",
      "name": "Save and Run"
     }
    ]
   }
  }
 ],
 "_note": "Shots 2-3 use table 1359 'DOCSHOT Published Posts' (created from shot 1's query). Its saved query was edited once in the UI to add title<>'' / ORDER BY / LIMIT 10 so the result has no blank titles."
}