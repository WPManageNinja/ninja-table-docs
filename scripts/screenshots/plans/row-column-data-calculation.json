     "width": 720,
     "height": 800
    },
    "highlights": [
     ".nt-col-tf textarea"
    ]
   }
  },
  {
   "front": "{{page:Quarterly Sales}}/"
  },
  {
   "wait": 300
  },
  {
   "eval": "(function(){var w=document.querySelector('.ninja_table_wrapper');var e=w;while(e&&e.tagName!='BODY'){var s=e.previousElementSibling;while(s){s.style.display='none';s=s.previousElementSibling}s=e.nextElementSibling;while(s){s.style.display='none';s=s.nextElementSibling}e=e.parentElement}})()"
  },
  {
   "wait": 1200
  },
  {
   "wait": 300
  },
  {
   "eval": "(function(){var t=document.querySelector('.ninja_table_wrapper table');var ths=[...t.querySelectorAll('thead th[class*=ninja_column_]')];var i=ths.findIndex(function(x){return x.innerText.trim().toLowerCase().indexOf(\"total\")===0});var rows=[...t.querySelectorAll('tbody tr')].filter(function(r){return r.offsetParent});var a=ths[i].getBoundingClientRect();var b=rows[rows.length-1].children[i].getBoundingClientRect();var d=document.createElement('div');d.id='nt-hl';d.style.cssText='position:absolute;pointer-events:none;left:'+(a.left+scrollX-2)+'px;top:'+(a.top+scrollY-2)+'px;width:'+(a.width+4)+'px;height:'+(b.bottom-a.top+4)+'px';document.body.appendChild(d)})()"
  },
  {
   "shot": {
    "name": "2.-Total-Column-Showing-The-Sum",
    "clip": {
     "element": ".ninja_table_wrapper",
     "pad": 24
    },
    "highlights": [
     "#nt-hl"
    ]
   }
  },
  {
   "admin": "/tables/{{Quarterly Sales by Store 2026}}/additional_css"
  },
  {
   "wait": 2000
  },
  {
   "click": {
    "text": "JavaScript"
   }
  },
  {
   "wait": 1000
  },
  {
   "eval": "var ed=document.querySelector('.ace_editor').env.editor;ed.renderer.updateFontSize();ed.resize(true);ed.renderer.updateFull(true);ed.renderer.scrollToY(0);ed.renderer.scrollToX(0)"
  },
  {
   "wait": 500
  },
  {
   "shot": {
    "name": "3.-Custom-JS-Editor-With-The-Column",
    "clip": "app"
   }
  },
  {
   "front": "{{page:Quarterly Sales}}/"
  },
  {
   "wait": 300
  },
  {
   "eval": "(function(){var w=document.querySelector('.ninja_table_wrapper');var e=w;while(e&&e.tagName!='BODY'){var s=e.previousElementSibling;while(s){s.style.display='none';s=s.previousElementSibling}s=e.nextElementSibling;while(s){s.style.display='none';s=s.nextElementSibling}e=e.parentElement}})()"
  },
  {
   "wait": 1200
  },
  {
   "wait": 300
  },
  {
   "shot": {
    "name": "4.-Table-With-A-Total-Row-Under",
