{
  "doc": "docs/ninja-charts/how-to-create-chart-manually-in-ninja-charts.md",
  "outDir": "public/images/ninja-charts/create-chart-manually-ninja",
  "adminPage": "ninja-charts",
  "appRoot": "#ninja-charts-app",
  "viewport": { "width": 1440, "height": 900 },
  "steps": [
    { "admin": "/add-chart" },
    { "fill": { "selector": "#ninja-charts-app input[type=text]", "value": "Team Size by Department" } },
    { "click": "#ninja-charts-app .el-select" },
    { "click": ".el-select-dropdown__item:has-text(\"Chart Js\")" },
    { "wait": 800 },
    { "click": "#ninja-charts-app .el-col:has(h4:text-is(\"Bar Chart\"))" },
    { "click": "#ninja-charts-app button:has-text(\"Next\")" },
    { "wait": 800 },
    { "click": "#ninja-charts-app .el-select" },
    { "click": ".el-select-dropdown__item:has-text(\"Manual Input\")" },
    { "wait": 800 },
    { "shot": { "name": "1.-Data-Source-Step-With-Manual-Input", "clip": "app", "crop": "auto",
        "highlights": [ { "selector": ".el-form-item", "hasText": "Source" } ] } },
    { "click": "#ninja-charts-app button:has-text(\"Next\")" },
    { "wait": 1000 },
    { "click": "#ninja-charts-app button:has-text(\"Add column\")" },
    { "fill": { "selector": ".el-dialog input", "value": "Team members" } },
    { "click": ".el-dialog button:has-text(\"Save\")" },
    { "wait": 800 },
    { "click": "#ninja-charts-app button.nc-add-new-button" },
    { "wait": 600 },
    { "fill": { "selector": ".el-dialog:visible input[type=text] >> nth=0", "value": "Engineering" } },
    { "fill": { "selector": ".el-dialog:visible input[type=number]", "value": "24" } },
    { "click": ".el-dialog:visible button:has-text(\"Add Data\")" },
    { "wait": 800 },
    { "fill": { "selector": ".el-dialog:visible input[type=text] >> nth=0", "value": "Design" } },
    { "fill": { "selector": ".el-dialog:visible input[type=number]", "value": "9" } },
    { "click": ".el-dialog:visible button:has-text(\"Add Data\")" },
    { "wait": 800 },
    { "fill": { "selector": ".el-dialog:visible input[type=text] >> nth=0", "value": "Marketing" } },
    { "fill": { "selector": ".el-dialog:visible input[type=number]", "value": "12" } },
    { "wait": 400 },
    { "shot": { "name": "2.-Manual-Input-Data-Range", "clip": "app", "crop": "auto",
        "highlights": [ { "selector": ".el-dialog:visible button", "hasText": "Add Data" } ] } }
  ]
}
