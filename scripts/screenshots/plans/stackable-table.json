{
  "doc": "docs/responsive-design/stackable-table.md",
  "outDir": "public/images/responsive-design/stackable-table",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "viewport": {
        "width": 1440,
        "height": 1000
      }
    },
    {
      "admin": "/tables/{{Quarterly Sales by Store 2026}}/design_studio"
    },
    {
      "wait": 2000
    },
    {
      "click": {
        "role": "tab",
        "name": "^Features$"
      }
    },
    {
      "wait": 500
    },
    {
      "css": ".nt-appearance{grid-template-columns:minmax(0,1fr) 520px!important}"
    },
    {
      "wait": 500
    },
    {
      "click": {
        "selector": ".nt-ds-sec__btn",
        "hasText": "Mobile"
      }
    },
    {
      "wait": 700
    },
    {
      "shot": {
        "name": "1.-Responsive-Breakpoint-Section-With-The-Drawer",
        "clip": {
          "x": 920,
          "y": 140,
          "width": 520,
          "height": 560
        }
      }
    },
    {
      "eval": "[...document.querySelectorAll('.nt-setting-row')].find(r=>/Stack Rows As Cards/i.test(r.textContent)).querySelector('.el-switch').click()"
    },
    {
      "wait": 700
    },
    {
      "eval": "document.querySelector('.nt-appearance').scrollTop=0;[...document.querySelectorAll('.nt-ds-subhead')].find(e=>/Stackable/.test(e.textContent)).scrollIntoView()"
    },
    {
      "wait": 500
    },
    {
      "shot": {
        "name": "2.-Stackable-Table-Section-With-The-Stack",
        "clip": {
          "x": 920,
          "y": 140,
          "width": 520,
          "height": 600
        }
      }
    }
  ]
}