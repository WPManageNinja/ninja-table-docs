{
 "doc": "docs/ninja-charts/how-to-use-data-range-picker-in-ninja-charts.md",
 "outDir": "public/images/ninja-charts/data-range-picker-ninja",
 "adminPage": "ninja-charts",
 "appRoot": "#ninja-charts-app",
 "viewport": {
  "width": 1440,
  "height": 1100
 },
 "steps": [
  {
   "admin": "/add-chart"
  },
  {
   "wait": 3000
  },
  {
   "fill": {
    "selector": ".el-input__inner >> nth=0",
    "value": "Regional Sales Overview"
   }
  },
  {
   "click": ".el-select"
  },
  {
   "wait": 600
  },
  {
   "click": {
    "selector": ".el-select-dropdown__item",
    "hasText": "Chart Js"
   }
  },
  {
   "wait": 800
  },
  {
   "click": {
    "text": "Bar Chart"
   }
  },
  {
   "wait": 500
  },
  {
   "click": {
    "role": "button",
    "name": "^next$"
   }
  },
  {
   "wait": 1200
  },
  {
   "click": ".el-select"
  },
  {
   "wait": 500
  },
  {
   "click": {
    "selector": ".el-select-dropdown__item",
    "hasText": "Ninja Tables"
   }
  },
  {
   "wait": 1200
  },
  {
   "click": ".el-select >> nth=1"
  },
  {
   "wait": 800
  },
  {
   "click": {
    "selector": ".el-select-dropdown__item",
    "hasText": "Monthly Sales by Region 2026"
   }
  },
  {
   "wait": 800
  },
  {
   "click": {
    "role": "button",
    "name": "^next$"
   }
  },
  {
   "wait": 3500
  },
  {
   "eval": "document.querySelectorAll('.el-popper.el-tooltip').forEach(e=>e.remove())"
  },
  {
   "click": {
    "selector": ".list-group-item",
    "hasText": "Month"
   }
  },
  {
   "wait": 400
  },
  {
   "eval": "document.querySelectorAll('.el-popper.el-tooltip').forEach(e=>e.remove())"
  },
  {
   "click": {
    "selector": ".list-group-item",
    "hasText": "North America"
   }
  },
  {
   "wait": 400
  },
  {
   "eval": "document.querySelectorAll('.el-popper.el-tooltip').forEach(e=>e.remove())"
  },
  {
   "click": {
    "selector": ".list-group-item",
    "hasText": "Europe"
   }
  },
  {
   "wait": 600
  },
  {
   "eval": "document.querySelectorAll('.el-popper.el-tooltip').forEach(e=>e.remove())"
  },
  {
   "shot": {
    "name": "1.-Data-Range-Step-With-Column-Lists",
    "clip": {
     "element": ".el-card.box-card",
     "pad": 24
    },
    "highlights": [
     {
      "selector": ".el-form-item",
      "hasText": "Number of Items"
     }
    ]
   }
  }
 ]
}